{
  "expo": {
    "name": "AI Life Planner",
    "slug": "ai-life-planner",
    "scheme": "ailifeplanner",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "web": {
      "output": "static",
      "bundler": "metro",
      "lang": "ja",
      "favicon": "./assets/favicon.png",
      "name": "AI Life Planner Demo",
      "description": "目標・タスクとサンプル予定から一日の計画を作る、ログイン不要のWeb Demo。"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uyu.ailifeplanner"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.READ_CALENDAR", "android.permission.WRITE_CALENDAR"],
      "package": "com.uyu.ailifeplanner"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "予定と重ならない計画のため、端末カレンダーの予定を読み取ります。",
          "remindersPermission": false
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
